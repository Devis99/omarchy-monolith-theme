# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#232136"

# Main text color
theme[main_fg]="#e0def4"

# Title color for boxes
theme[title]="#c4a7e7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9ccfd8"

# Background color of selected item in processes box
theme[selected_bg]="#3e8fb0"

# Foreground color of selected item in processes box
theme[selected_fg]="#e0def4"

# Color of inactive/disabled text
theme[inactive_fg]="#6e6a86"

# Color of text appearing on top of graphs, i.e. uptime and network scaling
theme[graph_text]="#e0def4"

# Background color of percentage meters
theme[meter_bg]="#393552"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#c4a7e7"

# Box outline and divider line color
theme[cpu_box]="#3e8fb0"
theme[mem_box]="#3e8fb0"
theme[net_box]="#3e8fb0"
theme[proc_box]="#3e8fb0"
theme[div_line]="#6e6a86"

# Gradient for all meters and graphs
theme[temp_start]="#9ccfd8"
theme[temp_mid]="#c4a7e7"
theme[temp_end]="#3e8fb0"


theme[cpu_start]="#9ccfd8"
theme[cpu_mid]="#c4a7e7"
theme[cpu_end]="#3e8fb0"


theme[free_start]="#c4a7e7"
theme[free_mid]="#f6c177"
theme[free_end]="#f6c177"


theme[cached_start]="#f6c177"
theme[cached_mid]="#f6c177"
theme[cached_end]="#f6c177"


theme[available_start]="#9ccfd8"
theme[available_mid]="#9ccfd8"
theme[available_end]="#9ccfd8"


theme[used_start]="#3e8fb0"
theme[used_mid]="#3e8fb0"
theme[used_end]="#3e8fb0"


theme[download_start]="#f6c177"
theme[download_mid]="#9ccfd8"
theme[download_end]="#c4a7e7"


theme[upload_start]="#f6c177"
theme[upload_mid]="#9ccfd8"
theme[upload_end]="#c4a7e7"

# Process box gradient for threads, memory, and CPU usage
theme[process_start]="#ea9a97"
theme[process_mid]="#9ccfd8"
theme[process_end]="#c4a7e7"

# Rosé Pine Moon neutral ramp for graph shading
theme[gradient_color_0]="#232136"
theme[gradient_color_1]="#2a273f"
theme[gradient_color_2]="#393552"
theme[gradient_color_3]="#6e6a86"
theme[gradient_color_4]="#908caa"
theme[gradient_color_5]="#e0def4"
theme[gradient_color_6]="#e0def4"
theme[gradient_color_7]="#56526e"
